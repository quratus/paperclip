DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me

# Hosted password recovery (Better Auth sendResetPassword).
# Trust the Campaign Studio origin so redirectTo / callbackURL pass origin checks.
# PAPERCLIP_AUTH_TRUSTED_ORIGINS=https://campaign-studio.sqncr.ai
# Transactional From + Resend key are required for live mail. Capture is tests/operators only.
# PAPERCLIP_RESET_PASSWORD_FROM=Campaign Studio <auth@example.test>
# RESEND_API_KEY=
# PAPERCLIP_RESET_PASSWORD_CAPTURE=1

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
